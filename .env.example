# Copy to .env.local. Keep real credentials out of Git and NEXT_PUBLIC_*.
# Use your deployed HTTPS origin, or https://localhost:3000 with npm run dev:https.
APP_URL=https://localhost:3000
MONGODB_URI=
# Generate each key separately with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_EMAIL_ENCRYPTION_KEY=
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. PlanBridge <accounts@example.com>
RESEND_FROM=
# Separate random 32+ character secret for the scheduled job endpoint.
CRON_SECRET=

# Validated implementation defaults; review before launch.
AUTH_PASSWORD_MIN_LENGTH=15
AUTH_SESSION_SECONDS=604800
AUTH_RESET_SECONDS=1800
